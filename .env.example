# Google Identity Services — required for a real "Sign in with Google".
#
# 1. https://console.cloud.google.com/apis/credentials → Create credentials →
#    OAuth client ID → Web application.
# 2. Authorised JavaScript origins: http://localhost:3000 (and your deployed
#    origin, when you have one).
# 3. Copy the client ID here. It is public by design — no secret is involved.
#
# Leave it empty and the app falls back to the clearly-labelled demo sign-in
# instead of pretending a Google login happened.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: canonical site URL used by robots.txt / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
